[Unit]
Description=Metronome WebSocket Server
After=network.target

[Service]
Type=simple
User=ernesto
WorkingDirectory=/home/ernesto/apps/metronome
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=PORT=3001
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
